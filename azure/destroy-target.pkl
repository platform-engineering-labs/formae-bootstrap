// Deregisters the bootstrap-target (the inverse of the target registered by
// bootstrap.pkl). Identified by label; config just needs to match the
// registered target.
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@azure/azure.pkl"
import "./vars.pkl"

forma {
    new formae.Target {
        label = "bootstrap-target"
        config = new azure.Config {
            subscriptionId = vars.subscriptionId
        }
    }
}
