amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@azure/azure.pkl"

import "@azure/resources/resourcegroup.pkl"
import "@azure/resources/virtualnetwork.pkl"
import "@azure/resources/subnet.pkl"
import "@azure/network/networksecuritygroup.pkl"
import "@azure/network/publicipaddress.pkl"
import "@azure/network/networkinterface.pkl"
import "@azure/network/privatednszone.pkl"
import "@azure/network/privatednsvnetlink.pkl"
import "@azure/network/privateendpoint.pkl"
import "@azure/network/privatednszonegroup.pkl"
import "@azure/dbforpostgresql/flexibleserver.pkl"
import "@azure/dbforpostgresql/database.pkl"
import "@azure/compute/virtualmachine.pkl"
import "@azure/compute/virtualmachineextension.pkl"
// appgw mode: public HTTPS via Application Gateway + a Key Vault certificate.
import "@azure/network/applicationgateway.pkl"
import "@azure/keyvault/vault.pkl"
import "@azure/keyvault/certificate.pkl"
import "@azure/managedidentity/userassignedidentity.pkl"
import "@azure/authorization/roleassignment.pkl"

import "./vars.pkl"
import "./sizing.pkl"

description {
    text = """
    Formae agent on Azure - the "install formae into a production environment"
    example. A long-running VM (the analog of the AWS ECS Fargate task and the
    GCP GCE VM) runs the agent container, in one of three access modes:

    - `public`: the agent terminates HTTPS itself with a self-signed certificate
      generated on the VM at first boot (server.tlsCert/tlsKey), reachable at a
      stable <name>.<location>.cloudapp.azure.com FQDN. Basic auth on top;
      inbound restricted to --allowed-cidr. Connecting requires the CLI's
      cli.api.insecureSkipVerify knob (formae PR #540).
    - `appgw`: public HTTPS terminated by an Application Gateway v2 in its own
      subnet, fronting the VM (which serves plain HTTP on the API port, reached
      only from the gateway subnet). The gateway's TLS cert is an
      AZURE::KeyVault::Certificate the stack provisions in a Key Vault it creates
      (self-signed by default, or your PFX via --cert-pfx), read at runtime via a
      user-assigned identity granted "Key Vault Secrets User". Mirrors the AWS
      `alb` mode (ALB + ACM). Point --domain's DNS at the gateway public IP.
    - `tailnet`: private, reached only over your Tailscale tailnet (no public
      inbound), serving a trusted *.ts.net certificate, with basic auth on top.
      Mirrors the AWS/GCP `tailnet` mode.

    Azure Database for PostgreSQL Flexible Server (public access disabled) backs
    the agent, reached through a Private Endpoint + privatelink DNS zone inside
    the VNet - no subnet delegation needed, TLS enforced (sslmode=require).

    The agent's operating identity is a service principal you create up front
    (az ad sp create-for-rbac); its credentials reach the agent as environment
    variables via the CustomScript extension's protectedSettings (write-only,
    encrypted by Azure, never readable back through the API). The azure plugin
    has no VM managed-identity property yet - when it lands, the SP can be
    replaced by a system-assigned identity and secrets can move to Key Vault
    fetched at boot.

    The VM keeps a public IP in BOTH modes: Azure retired default outbound
    access for new VMs and the plugin has no NAT Gateway resource yet, so the
    public IP provides egress (image pulls, tailnet). In tailnet mode no NSG
    inbound rule exists, so nothing can reach it from the internet.
    """
    confirm = true
}

properties {
    name = new formae.Prop {
        flag = "name"
        default = vars.projectName
    }
    location = new formae.Prop {
        flag = "location"
        default = vars.location
    }
    // Azure subscription the agent's infrastructure lives in. Required.
    subscriptionId = new formae.Prop {
        flag = "subscription-id"
        default = vars.subscriptionId
    }
    // Entra tenant of the subscription. Required (service-principal login).
    tenantId = new formae.Prop {
        flag = "tenant-id"
        default = ""
    }
    // Service principal the agent operates Azure with (az ad sp create-for-rbac
    // --role Contributor --scopes /subscriptions/<sub>). Required.
    clientId = new formae.Prop {
        flag = "client-id"
        default = ""
    }
    clientSecret = new formae.Prop {
        flag = "client-secret"
        default = ""
    }
    // VM t-shirt size; maps to an Azure VM size (see sizing.pkl).
    size = new formae.Prop {
        flag = "size"
        default = "small"
    }
    // `public` (self-signed), `appgw` (App Gateway + Key Vault cert), or
    // `tailnet` (private, Tailscale).
    access = new formae.Prop {
        flag = "access"
        default = "public"
    }
    // Full agent image reference. Upgrade the agent by re-applying with a newer tag.
    formaeImage = new formae.Prop {
        flag = "formae-image"
        default = vars.formaeImage
    }
    // Basic-auth username for the agent API.
    apiUser = new formae.Prop {
        flag = "api-user"
        default = "formae"
    }
    // Basic-auth password as a BCRYPT HASH (not plaintext). Generate locally with
    // azure/scripts/gen-api-credential.sh.
    apiPasswordHash = new formae.Prop {
        flag = "api-password-hash"
        default = ""
    }
    // Postgres admin password. Supplied (not generated in-forma) so the value is
    // stable across applies; gen-api-credential.sh prints one.
    dbPassword = new formae.Prop {
        flag = "db-password"
        default = ""
    }
    // SSH public key for the VM admin user (Azure requires one even if you never
    // log in). ssh-keygen -t ed25519 works.
    sshPublicKey = new formae.Prop {
        flag = "ssh-public-key"
        default = ""
    }
    // public mode only: CIDR allowed to reach the agent API. Default: everywhere
    // (basic auth + TLS still apply). Tighten for production.
    allowedCidr = new formae.Prop {
        flag = "allowed-cidr"
        default = "*"
    }
    // appgw mode only: the hostname clients connect to (must match the cert's
    // subject/SAN). Point its DNS at the Application Gateway's public IP.
    domain = new formae.Prop {
        flag = "domain"
        default = ""
    }
    // appgw mode only: globally-unique Key Vault name (3-24 chars, alphanumeric +
    // hyphen, starts with a letter). The stack creates this vault to hold the cert.
    kvName = new formae.Prop {
        flag = "kv-name"
        default = ""
    }
    // appgw mode only: objectId (principal object ID, NOT the appId) of the
    // principal running this apply — granted "Key Vault Certificates Officer" on
    // the new vault so the plugin can create the certificate (data-plane). Find it
    // with: az ad sp show --id <client-id> --query id -o tsv
    applierObjectId = new formae.Prop {
        flag = "applier-object-id"
        default = ""
    }
    // appgw mode, optional: base64-encoded PFX to import as the gateway cert. When
    // omitted, the stack issues a self-signed cert (works, but not browser-trusted).
    certPfx = new formae.Prop {
        flag = "cert-pfx"
        default = ""
    }
    // appgw mode, optional: password for --cert-pfx.
    certPassword = new formae.Prop {
        flag = "cert-password"
        default = ""
    }
    // tailnet mode only: a reusable Tailscale auth key (tagged tag:formae).
    tsAuthkey = new formae.Prop {
        flag = "ts-authkey"
        default = ""
    }
    // tailnet mode only: the tailnet (MagicDNS) hostname. Defaults to --name.
    tsHostname = new formae.Prop {
        flag = "ts-hostname"
        default = ""
    }
    vnetCidr = new formae.Prop {
        flag = "vnet-cidr"
        default = vars.vnetCidr
    }
    subnetCidr = new formae.Prop {
        flag = "subnet-cidr"
        default = vars.subnetCidr
    }
}

// ── Required inputs ───────────────────────────────────────────────────────────
local access =
    let (a = properties.access.value)
    if (a != "public" && a != "appgw" && a != "tailnet")
        throw("--access must be \"public\", \"appgw\" or \"tailnet\" (got \"\(a)\")")
    else a
local isPublic = access == "public"
local isAppgw = access == "appgw"
local isTailnet = access == "tailnet"

// appgw-mode required inputs (referenced only inside the appgw branch).
local domainVal =
    if (isAppgw && properties.domain.value == "") throw("--domain is required for --access appgw (the hostname clients connect to; point its DNS at the gateway public IP)")
    else properties.domain.value
local kvNameVal =
    if (isAppgw && properties.kvName.value == "") throw("--kv-name is required for --access appgw (a globally-unique Key Vault name, 3-24 chars)")
    else properties.kvName.value
local applierObjectIdVal =
    if (isAppgw && properties.applierObjectId.value == "") throw("--applier-object-id is required for --access appgw (objectId of the applying principal; az ad sp show --id <client-id> --query id -o tsv)")
    else properties.applierObjectId.value
local certPfxVal = properties.certPfx.value
local certPasswordVal = properties.certPassword.value

local subscriptionIdVal =
    if (properties.subscriptionId.value == "") throw("--subscription-id is required (the Azure subscription ID)")
    else properties.subscriptionId.value
local tenantIdVal =
    if (properties.tenantId.value == "") throw("--tenant-id is required (the Entra tenant ID)")
    else properties.tenantId.value
local clientIdVal =
    if (properties.clientId.value == "") throw("--client-id is required (service principal appId; az ad sp create-for-rbac)")
    else properties.clientId.value
local clientSecretVal =
    if (properties.clientSecret.value == "") throw("--client-secret is required (service principal password)")
    else properties.clientSecret.value
local apiPasswordHashVal =
    if (properties.apiPasswordHash.value == "") throw("--api-password-hash is required. Generate it with azure/scripts/gen-api-credential.sh")
    else properties.apiPasswordHash.value
local dbPasswordVal =
    if (properties.dbPassword.value == "") throw("--db-password is required (a stable Postgres admin password; gen-api-credential.sh prints one)")
    else properties.dbPassword.value
local sshPublicKeyVal =
    if (properties.sshPublicKey.value == "") throw("--ssh-public-key is required (contents of e.g. ~/.ssh/id_ed25519.pub)")
    else properties.sshPublicKey.value
local tsAuthkeyVal =
    if (isTailnet && properties.tsAuthkey.value == "") throw("--ts-authkey is required for --access tailnet (a reusable Tailscale auth key)")
    else properties.tsAuthkey.value

local n = properties.name.value
local loc = properties.location.value
local vmSizeVal = sizing.forSize(properties.size.value)
local tsHostnameVal = if (properties.tsHostname.value == "") n else properties.tsHostname.value
local dbServerName = "\(n)-db"
// Flexible Server FQDNs are deterministic; inside the VNet the privatelink DNS
// zone resolves this to the private endpoint's IP.
local dbFqdn = "\(dbServerName).postgres.database.azure.com"
// public mode: the stable DNS name the self-signed certificate is issued for.
local agentFqdn = "\(n).\(loc).cloudapp.azure.com"

// Every bootstrap-tier resource carries the app=formae-agent tag so the agent's
// own discovery filter (emitted into the config below) can suppress this stack's
// substrate rather than surfacing it as unmanaged drift.
local commonTags: Listing<azure.Tag> = new {
    new azure.Tag { key = "app"; value = "formae-agent" }
}

// ── Agent config file (written on the VM by the bootstrap script) ─────────────
// auth-basic + server (TLS in public mode) + postgres datastore (private
// endpoint FQDN, TLS enforced) + background work + (tailnet mode) a top-level
// tailscale network block. Values are Pkl-interpolated at apply time; the whole
// script travels in the CustomScript extension's protectedSettings (write-only,
// encrypted by Azure).
local serverTlsLines =
    if (isPublic) "\n    tlsCert = \"/home/pel/.config/formae/tls.crt\"\n    tlsKey = \"/home/pel/.config/formae/tls.key\""
    else ""

local networkBlock =
    if (isTailnet) """

network = new NetworkConfig {
  type = "tailscale"
  tailscale = new TailscaleConfig {
    tls = true
    authKey = "\(tsAuthkeyVal)"
    hostname = "\(tsHostnameVal)"
    advertiseTags { "tag:formae" }
  }
}
"""
    else ""

local agentConfig = """
amends "formae:/Config.pkl"
import "plugins:/Azure.pkl" as Azure
import "plugins:/AuthBasic.pkl" as AuthBasic
agent {
  auth = new AuthBasic.AgentConfig {
    authorizedUsers {
      new AuthBasic.AuthorizedUser {
        username = "\(properties.apiUser.value)"
        password = "\(apiPasswordHashVal)"
      }
    }
  }
  server {
    port = \(vars.formaePort)\(serverTlsLines)
  }
  datastore {
    datastoreType = "postgres"
    postgres {
      host = "\(dbFqdn)"
      port = 5432
      user = "\(vars.dbUser)"
      password = "\(dbPasswordVal)"
      database = "\(vars.dbName)"
      connectionParams = "sslmode=require"
    }
  }
  synchronization {
    enabled = true
    interval = 300.s
  }
  discovery {
    enabled = true
    interval = 600.s
  }
  resourcePlugins {
    new Azure.PluginConfig {
      // Suppress this agent's own substrate (everything tagged app=formae-agent)
      // from discovery so it is not surfaced as unmanaged drift. NOTE: the exact
      // Azure tag filter path is provider-specific and must be validated against
      // a live discovery run; adjust the propertyPath if the substrate still leaks.
      discoveryFilters = new Listing {
        new MatchFilter {
          conditions = new Listing {
            new FilterCondition {
              propertyPath = "$.tags.app"
              propertyValue = "formae-agent"
            }
          }
        }
      }
    }
  }
}\(networkBlock)
"""

// ── VM bootstrap script (Ubuntu 22.04, via CustomScript extension) ────────────
// Installs docker, prepares mode-specific state (self-signed TLS cert / tsnet
// identity dir), writes the agent config, and starts the agent container. The
// script re-runs only when the extension resource is replaced, not on reboot;
// --restart always keeps the containers up across reboots. Because the script
// travels in protectedSettings, any change to it (e.g. a new --formae-image)
// changes the extension's inputs and triggers a re-run — this is how upgrades
// land. Validated live end-to-end in both access modes.
local tlsSetup =
    if (isPublic) """
    # Self-signed certificate for the agent's public FQDN. Regenerated only when
    # the VM is replaced. Readable by the container's non-root 'pel' user.
    # ponytail: world-readable key on a single-purpose VM; swap for a Key Vault
    # certificate + managed identity once the plugin can attach one.
    openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \\
      -keyout /var/formae/tls.key -out /var/formae/tls.crt \\
      -subj "/CN=\(agentFqdn)" -addext "subjectAltName=DNS:\(agentFqdn)"
    chmod 0644 /var/formae/tls.crt /var/formae/tls.key
    """
    else if (isTailnet) """
    # Persistent tsnet identity dir. Lives on the OS disk: the azure plugin has
    # no VM data-disk attachment yet, so the tailnet machine identity survives
    # reboots but NOT VM replacement (the node re-registers via the auth key;
    # delete the stale node in the Tailscale admin console after a replace).
    mkdir -p /var/lib/tsnet
    # The agent container runs as non-root 'pel'; make the state dir writable.
    chmod 0777 /var/lib/tsnet
    """
    // appgw mode: the Application Gateway terminates TLS, so the agent serves
    // plain HTTP on the API port — no on-VM cert and no tsnet state to prepare.
    else ""

local dockerMounts =
    if (isPublic) "-v /var/formae/tls.crt:/home/pel/.config/formae/tls.crt -v /var/formae/tls.key:/home/pel/.config/formae/tls.key"
    else if (isTailnet) "-v /var/lib/tsnet:/home/pel/.config/tsnet-formae"
    else ""

local bootstrapScript = """
#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# The CustomScript extension races cloud-init, which rewrites the apt sources
# on first boot - apt sees half-configured lists and "cannot locate" packages
# that are plainly in universe. Wait for cloud-init before touching apt.
cloud-init status --wait >/dev/null 2>&1 || true

# Retry transient ops: apt mirrors and registry pulls (ghcr.io) can time out
# right after boot. 6 tries x 10s. update+install retried as ONE unit so a
# torn package list is refreshed before the next install attempt.
retry() { local n=0; until "$@"; do n=$((n+1)); [ "$n" -ge 6 ] && return 1; echo "retry $n: $*"; sleep 10; done; }

retry bash -c 'apt-get update -y && apt-get install -y docker.io'
systemctl enable --now docker

mkdir -p /var/formae
\(tlsSetup)
# Quoted heredoc: everything (including the bcrypt hash's $2y$... prefix) is
# already final text - nothing must be shell-expanded.
cat > /var/formae/formae.conf.pkl << 'PKLEOF'
\(agentConfig)
PKLEOF

FORMAE_IMAGE="\(properties.formaeImage.value)"
retry docker pull "$FORMAE_IMAGE"
docker rm -f formae-agent >/dev/null 2>&1 || true
docker run -d --restart always --name formae-agent --network host \\
  \(dockerMounts) \\
  -v /var/formae/formae.conf.pkl:/home/pel/.config/formae/formae.conf.pkl \\
  -e AZURE_TENANT_ID='\(tenantIdVal)' \\
  -e AZURE_CLIENT_ID='\(clientIdVal)' \\
  -e AZURE_CLIENT_SECRET='\(clientSecretVal)' \\
  "$FORMAE_IMAGE" \\
  formae agent start --config /home/pel/.config/formae/formae.conf.pkl
"""

// ── Manifest ──────────────────────────────────────────────────────────────────
forma {
    vars.stack
    new formae.Target {
        // Cloud-scoped label: the aws/ and gcp/ bootstraps register "bootstrap-target",
        // and a target label is unique per agent across namespaces - reusing it here
        // fails when the same local agent has bootstrapped another cloud before.
        label = "azure-bootstrap-target"
        config = new azure.Config {
            subscriptionId = subscriptionIdVal
        }
    }

    // resource group + networking
    rg
    vnet
    snet
    nsg
    pip
    nic

    // database (private endpoint + privatelink DNS)
    db
    dbDatabase
    dnsZone
    dnsLink
    pe
    peDns

    // compute
    vm
    ext

    // appgw mode: dedicated subnet + public IP + Key Vault + certificate +
    // user-assigned identity (+ its vault role) + the Application Gateway.
    when (isAppgw) {
        appgwSubnet
        appgwPip
        kvVault
        appgwIdentity
        roleSecretsUser
        roleCertsOfficer
        cert
        appgw
    }
}

// ── Resource group + networking ───────────────────────────────────────────────
local rg = new resourcegroup.ResourceGroup {
    label = "\(n)-rg"
    name = "\(n)-rg"
    location = loc
    tags = commonTags
}

local vnet = new virtualnetwork.VirtualNetwork {
    label = "\(n)-vnet"
    name = "\(n)-vnet"
    location = loc
    resourceGroupName = rg.res.name
    addressSpace = new virtualnetwork.AddressSpace {
        addressPrefixes { properties.vnetCidr.value }
    }
    tags = commonTags
}

local snet = new subnet.Subnet {
    label = "\(n)-subnet"
    name = "\(n)-subnet"
    resourceGroupName = rg.res.name
    virtualNetworkName = vnet.res.name
    addressPrefix = properties.subnetCidr.value
}

local nsg = new networksecuritygroup.NetworkSecurityGroup {
    label = "\(n)-nsg"
    name = "\(n)-nsg"
    location = loc
    resourceGroupName = rg.res.name
    // public: the agent API port from --allowed-cidr. tailnet: no inbound rules
    // at all - Azure's default rules deny internet inbound; tailscale needs
    // outbound only.
    securityRules = new Listing {
        when (isPublic) {
            new networksecuritygroup.SecurityRule {
                name = "allow-agent-api"
                priority = 100
                direction = "Inbound"
                access = "Allow"
                protocol = "Tcp"
                sourceAddressPrefix = properties.allowedCidr.value
                sourcePortRange = "*"
                destinationAddressPrefix = "*"
                destinationPortRange = "\(vars.formaePort)"
            }
        }
        // appgw mode: only the Application Gateway subnet may reach the API port;
        // the internet reaches the gateway (:443), never the VM directly.
        when (isAppgw) {
            new networksecuritygroup.SecurityRule {
                name = "allow-agent-api-from-appgw"
                priority = 100
                direction = "Inbound"
                access = "Allow"
                protocol = "Tcp"
                sourceAddressPrefix = vars.appgwSubnetCidr
                sourcePortRange = "*"
                destinationAddressPrefix = "*"
                destinationPortRange = "\(vars.formaePort)"
            }
        }
    }
    tags = commonTags
}

// Public IP in BOTH modes: egress (Azure retired default outbound access; the
// plugin has no NAT Gateway resource yet). Inbound is governed by the NSG.
// The DNS label gives the stable FQDN the public-mode certificate is issued for.
local pip = new publicipaddress.PublicIPAddress {
    label = "\(n)-pip"
    name = "\(n)-pip"
    location = loc
    resourceGroupName = rg.res.name
    sku = new publicipaddress.PublicIPAddressSKU { name = "Standard" }
    publicIPAllocationMethod = "Static"
    dnsSettings = new publicipaddress.DnsSettings { domainNameLabel = n }
    tags = commonTags
}

local nic = new networkinterface.NetworkInterface {
    label = "\(n)-nic"
    name = "\(n)-nic"
    location = loc
    resourceGroupName = rg.res.name
    ipConfigurations {
        new networkinterface.IPConfiguration {
            name = "primary"
            subnet = snet.res.id
            publicIPAddress = pip.res.id
            // appgw mode: static private IP so the gateway backend pool can target
            // the VM by address. Other modes: dynamic (nothing references it).
            privateIPAllocationMethod = if (isAppgw) "Static" else "Dynamic"
            privateIPAddress = if (isAppgw) vars.vmPrivateIp else null
            primary = true
        }
    }
    networkSecurityGroup = nsg.res.id
    tags = commonTags
}

// ── Database ──────────────────────────────────────────────────────────────────
local db = new flexibleserver.FlexibleServer {
    label = "\(n)-db"
    name = dbServerName
    location = loc
    resourceGroupName = rg.res.name
    sku = new flexibleserver.SKU {
        name = vars.dbSkuName
        tier = vars.dbSkuTier
    }
    version = vars.dbVersion
    administratorLogin = vars.dbUser
    // Set once at creation; the agent config carries the same value.
    administratorLoginPassword = dbPasswordVal
    storage = new flexibleserver.Storage {
        storageSizeGB = vars.dbStorageGb
        autoGrow = "Enabled"
    }
    // Reached exclusively through the private endpoint below.
    network = new flexibleserver.Network {
        publicNetworkAccess = "Disabled"
    }
    tags = commonTags
}

local dbDatabase = new database.Database {
    label = "\(n)-db-database"
    name = vars.dbName
    resourceGroupName = rg.res.name
    serverName = db.res.name
}

local dnsZone = new privatednszone.PrivateDnsZone {
    label = "\(n)-pdns"
    name = "privatelink.postgres.database.azure.com"
    location = "global"
    resourceGroupName = rg.res.name
    tags = commonTags
}

local dnsLink = new privatednsvnetlink.PrivateDnsZoneVirtualNetworkLink {
    label = "\(n)-pdns-link"
    name = "\(n)-pdns-link"
    location = "global"
    resourceGroupName = rg.res.name
    privateZoneName = dnsZone.res.name
    virtualNetworkId = vnet.res.id
    registrationEnabled = false
    tags = commonTags
}

local pe = new privateendpoint.PrivateEndpoint {
    label = "\(n)-db-pe"
    name = "\(n)-db-pe"
    location = loc
    resourceGroupName = rg.res.name
    subnetId = snet.res.id
    privateLinkServiceConnections {
        new privateendpoint.PrivateLinkServiceConnection {
            name = "\(n)-db-plsc"
            privateLinkServiceId = db.res.id
            groupIds { "postgresqlServer" }
        }
    }
    tags = commonTags
}

local peDns = new privatednszonegroup.PrivateDnsZoneGroup {
    label = "\(n)-db-pe-dns"
    name = "default"
    resourceGroupName = rg.res.name
    privateEndpointName = pe.res.name
    privateDnsZoneConfigs {
        new privatednszonegroup.PrivateDnsZoneConfig {
            name = "postgres"
            privateDnsZoneId = dnsZone.res.id
        }
    }
}

// ── Compute ───────────────────────────────────────────────────────────────────
local vm = new virtualmachine.VirtualMachine {
    label = "\(n)-vm"
    name = "\(n)-agent"
    location = loc
    resourceGroupName = rg.res.name
    vmSize = vmSizeVal
    networkInterfaces {
        new virtualmachine.NetworkInterfaceReference {
            id = nic.res.id
            primary = true
        }
    }
    imageReference = new virtualmachine.ImageReference {
        publisher = vars.vmImagePublisher
        offer = vars.vmImageOffer
        sku = vars.vmImageSku
        version = vars.vmImageVersion
    }
    osDisk = new virtualmachine.OSDisk {
        createOption = "FromImage"
        managedDisk = new virtualmachine.ManagedDiskParameters {
            storageAccountType = "StandardSSD_LRS"
        }
        diskSizeGB = vars.osDiskSizeGb
        deleteOption = "Delete"
    }
    adminUsername = vars.vmAdminUser
    linuxConfiguration = new virtualmachine.LinuxConfiguration {
        disablePasswordAuthentication = true
        ssh = new virtualmachine.SSHConfiguration {
            publicKeys {
                new virtualmachine.SSHPublicKey {
                    path = "/home/\(vars.vmAdminUser)/.ssh/authorized_keys"
                    keyData = sshPublicKeyVal
                }
            }
        }
    }
    tags = commonTags
}

// CustomScript extension carries the whole bootstrap script (secrets included)
// in protectedSettings: write-only, encrypted by Azure, never returned by the
// API - the Azure stand-in for "fetch from a vault at boot" until the plugin
// can attach a managed identity to the VM.
local ext = new virtualmachineextension.VirtualMachineExtension {
    label = "\(n)-vm-bootstrap"
    name = "bootstrap"
    location = loc
    resourceGroupName = rg.res.name
    virtualMachineName = vm.res.name
    publisher = "Microsoft.Azure.Extensions"
    type = "CustomScript"
    typeHandlerVersion = "2.1"
    autoUpgradeMinorVersion = true
    protectedSettings = new Mapping {
        ["script"] = bootstrapScript.base64
    }
    tags = commonTags
}

// ── appgw mode: Application Gateway public-HTTPS ingress ───────────────────────
// A dedicated subnet + Standard public IP front an Application Gateway v2 that
// terminates TLS with a Key Vault certificate and forwards HTTP to the VM's
// static private IP. The gateway reads the cert at runtime via a user-assigned
// identity granted "Key Vault Secrets User" on the vault; the applying principal
// is granted "Key Vault Certificates Officer" so the plugin can create the cert
// (a data-plane operation). Mirrors the AWS `alb` mode.

// App Gateway v2 requires its own subnet (no other resources in it).
local appgwSubnet = new subnet.Subnet {
    label = "\(n)-appgw-subnet"
    name = "\(n)-appgw-subnet"
    resourceGroupName = rg.res.name
    virtualNetworkName = vnet.res.name
    addressPrefix = vars.appgwSubnetCidr
}

local appgwPip = new publicipaddress.PublicIPAddress {
    label = "\(n)-appgw-pip"
    name = "\(n)-appgw-pip"
    location = loc
    resourceGroupName = rg.res.name
    sku = new publicipaddress.PublicIPAddressSKU { name = "Standard" }
    publicIPAllocationMethod = "Static"
    dnsSettings = new publicipaddress.DnsSettings { domainNameLabel = "\(n)-gw" }
    tags = commonTags
}

// RBAC-authorized vault: access is granted via role assignments below (an
// access policy cannot take the identity's resolved principalId).
local kvVault = new vault.Vault {
    label = "\(n)-kv"
    name = kvNameVal
    location = loc
    resourceGroupName = rg.res.name
    tenantId = tenantIdVal
    sku = new vault.VaultSKU { name = "standard" }
    enableRbacAuthorization = true
    tags = commonTags
}

local appgwIdentity = new userassignedidentity.UserAssignedIdentity {
    label = "\(n)-appgw-id"
    name = "\(n)-appgw-id"
    location = loc
    resourceGroupName = rg.res.name
    tags = commonTags
}

// Built-in role: "Key Vault Secrets User" — lets the gateway identity read the
// cert's secret (the PFX) at runtime.
local roleSecretsUser = new roleassignment.RoleAssignment {
    label = "\(n)-kv-secrets-user"
    scope = kvVault.res.id
    principalId = appgwIdentity.res.principalId
    principalType = "ServicePrincipal"
    roleDefinitionId = "/subscriptions/\(subscriptionIdVal)/providers/Microsoft.Authorization/roleDefinitions/4633458b-17de-408a-b874-0445c86b69e6"
}

// Built-in role: "Key Vault Certificates Officer" — lets the applying principal
// create the certificate (a data-plane operation ARM Contributor does not grant).
local roleCertsOfficer = new roleassignment.RoleAssignment {
    label = "\(n)-kv-certs-officer"
    scope = kvVault.res.id
    principalId = applierObjectIdVal
    roleDefinitionId = "/subscriptions/\(subscriptionIdVal)/providers/Microsoft.Authorization/roleDefinitions/a4417e6f-fecd-4de8-b567-7b0420556985"
}

// The gateway's TLS certificate. Self-signed by default (works, not browser
// trusted); pass --cert-pfx (+ --cert-password) to import your own trusted PFX.
local cert = new certificate.Certificate {
    label = "\(n)-cert"
    name = "agent-tls"
    vaultUri = kvVault.res.vaultUri
    data = if (certPfxVal != "") formae.value(certPfxVal).opaque else null
    password = if (certPfxVal != "") formae.value(certPasswordVal).opaque else null
    policy = if (certPfxVal == "") new certificate.Policy {
        issuerName = "Self"
        subject = "CN=\(domainVal)"
        validityMonths = 12
    } else null
    tags = commonTags
}

local appgw = new applicationgateway.ApplicationGateway {
    label = "\(n)-appgw"
    name = "\(n)-appgw"
    location = loc
    resourceGroupName = rg.res.name
    sku = new applicationgateway.ApplicationGatewaySKU {
        name = "Standard_v2"
        tier = "Standard_v2"
        capacity = 1
    }
    identity = new applicationgateway.Identity {
        type = "UserAssigned"
        userAssignedIdentityIds { appgwIdentity.res.id }
    }
    gatewayIPConfigurations {
        new applicationgateway.GatewayIPConfiguration {
            name = "gwip"
            subnetId = appgwSubnet.res.id
        }
    }
    frontendIPConfigurations {
        new applicationgateway.FrontendIPConfiguration {
            name = "feip"
            publicIPAddressId = appgwPip.res.id
        }
    }
    frontendPorts {
        new applicationgateway.FrontendPort { name = "https"; port = 443 }
    }
    sslCertificates {
        new applicationgateway.SSLCertificate {
            name = "agent-cert"
            keyVaultSecretId = cert.res.secretId
        }
    }
    backendAddressPools {
        new applicationgateway.BackendAddressPool {
            name = "agent-pool"
            backendAddresses {
                new applicationgateway.BackendAddress { ipAddress = vars.vmPrivateIp }
            }
        }
    }
    backendHttpSettingsCollection {
        new applicationgateway.BackendHTTPSettings {
            name = "agent-http"
            port = vars.formaePort
            protocol = "Http"
            probeName = "agent-health"
            requestTimeout = 30
            cookieBasedAffinity = "Disabled"
        }
    }
    httpListeners {
        new applicationgateway.HTTPListener {
            name = "l443"
            frontendIPConfigurationName = "feip"
            frontendPortName = "https"
            protocol = "Https"
            sslCertificateName = "agent-cert"
            hostName = domainVal
        }
    }
    requestRoutingRules {
        new applicationgateway.RequestRoutingRule {
            name = "r1"
            ruleType = "Basic"
            priority = 100
            httpListenerName = "l443"
            backendAddressPoolName = "agent-pool"
            backendHTTPSettingsName = "agent-http"
        }
    }
    probes {
        new applicationgateway.Probe {
            name = "agent-health"
            protocol = "Http"
            path = "/api/v1/health"
            host = vars.vmPrivateIp
            port = vars.formaePort
            interval = 30
            timeout = 30
            unhealthyThreshold = 3
        }
    }
    tags = commonTags
}
