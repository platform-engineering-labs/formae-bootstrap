extends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@aws/aws.pkl"

import "@aws/ec2/vpc.pkl"
import "@aws/ec2/internetgateway.pkl"
import "@aws/ec2/vpcgatewayattachment.pkl"
import "@aws/ec2/subnet.pkl"
import "@aws/ec2/routetable.pkl"
import "@aws/ec2/route.pkl"
import "@aws/ec2/subnetroutetableassociation.pkl"
import "@aws/ec2/securitygroup.pkl"
import "@aws/ec2/securitygroupingress.pkl"
import "@aws/ec2/eip.pkl"
import "@aws/ec2/natgateway.pkl"

import "@aws/rds/dbinstance.pkl"
import "@aws/rds/dbsubnetgroup.pkl"
import "@aws/secretsmanager/secret.pkl"
import "@formae/ext/random.pkl"

import "@aws/ecs/ecscluster.pkl"
import "@aws/ecs/taskdefinition.pkl"
import "@aws/ecs/service.pkl"

import "@aws/iam/role.pkl"
import "@aws/logs/loggroup.pkl"

import "@aws/elasticloadbalancingv2/loadbalancer.pkl"
import "@aws/elasticloadbalancingv2/targetgroup.pkl"
import "@aws/elasticloadbalancingv2/listener.pkl"

import "@aws/efs/filesystem.pkl"
import "@aws/efs/mounttarget.pkl"
import "@aws/efs/accesspoint.pkl"

import "./vars.pkl"
import "./sizing.pkl"

description {
    text = """
    Formae agent on AWS — the "install formae into a production environment" example.
    One entrypoint, two secure access modes via --access (there is no plaintext option):

      alb      Public, internet-facing ALB terminating HTTPS with YOUR ACM certificate
               (--cert-arn + --domain), with HTTP basic auth on top. Requires a domain
               you own. Optionally restrict ingress with --allow-cidr.

      tailnet  Private, reached only over your Tailscale tailnet — no public ingress.
               The agent joins the tailnet (--ts-authkey) and serves a trusted *.ts.net
               certificate. Mirrors our production topology: private subnets + NAT gateway
               + an EFS volume that persists the tsnet machine identity across restarts.

    Database (both modes) via --database:
      new       (default) provisions an RDS PostgreSQL with a generated master password.
      existing  brings your own PostgreSQL; supply --db-host/--db-user/--db-name and
                --db-password-secret-arn. No database is created.
    """
    confirm = true
}

properties: Props

class Props {
    // ── Shared ────────────────────────────────────────────────────────────────
    /// Access mode: "alb" (public HTTPS + basic auth) or "tailnet" (private, Tailscale).
    access: String = "alb"

    name: String = vars.projectName

    /// --region/--aws-profile govern the LOCAL apply credentials (which build the infra),
    /// not the deployed agent (which authenticates via its ECS task role).
    region: String = vars.region

    /// The flag is --aws-profile, not --profile, which formae reserves for its own CLI profiles.
    @formae.Flag { name = "aws-profile" }
    profile: String = ""

    /// ECS Fargate t-shirt size; maps to a Fargate-legal cpu/memory pair (see sizing.pkl).
    size: String = "small"

    /// "new" provisions an RDS database; "existing" points the agent at one you run.
    database: String = "new"

    /// Full agent image reference — stock ghcr, an ECR mirror, or a custom image with extra
    /// plugins. Upgrade the agent by re-applying with a newer tag/ref (ECS rolls the task).
    @formae.Flag { name = "formae-image" }
    formaeImage: String = vars.formaeImage

    /// Basic-auth username for the agent API (both modes).
    @formae.Flag { name = "api-user" }
    apiUser: String = "formae"

    /// Basic-auth password as a BCRYPT HASH (not plaintext), required in both modes.
    /// Generate locally: aws/scripts/gen-api-credential.sh (htpasswd -nbBC 10 "" <pw> | cut -d: -f2).
    /// Stored in an in-stack Secrets Manager secret and injected at task start.
    @formae.Flag { name = "api-password-hash" }
    apiPasswordHash: String = ""

    // ── alb mode ────────────────────────────────────────────────────────────────
    /// ARN of an ACM certificate (same region) for a domain you own. Required for --access alb.
    @formae.Flag { name = "cert-arn" }
    certArn: String = ""

    /// The hostname clients connect to (must match the cert). Point its DNS at the ALB.
    domain: String = ""

    /// Optionally narrow ALB ingress to one CIDR (e.g. "203.0.113.4/32") instead of 0.0.0.0/0.
    @formae.Flag { name = "allow-cidr" }
    allowCidr: String = ""

    // ── tailnet mode ──────────────────────────────────────────────────────────────
    /// A reusable Tailscale auth key. Required for --access tailnet. Stored in an in-stack
    /// Secrets Manager secret and injected at task start; the agent joins the tailnet with it.
    @formae.Flag { name = "ts-authkey" }
    tsAuthkey: String = ""

    /// The tailnet (MagicDNS) hostname the agent registers as. Defaults to --name.
    @formae.Flag { name = "ts-hostname" }
    tsHostname: String = ""

    // ── existing-database connection (consumed only when --database=existing) ─────
    @formae.Flag { name = "db-host" }
    dbHost: String = ""

    @formae.Flag { name = "db-port" }
    dbPort: String = "5432"

    @formae.Flag { name = "db-user" }
    dbUser: String = ""

    @formae.Flag { name = "db-name" }
    dbName: String = ""

    @formae.Flag { name = "db-password-secret-arn" }
    dbPasswordSecretArn: String = ""

    // ── VPC + subnet CIDRs ────────────────────────────────────────────────────────
    /// Subnets MUST sit within the VPC CIDR (AWS rejects mismatches).
    @formae.Flag { name = "vpc-cidr" }
    vpcCidr: String = vars.vpcCidr

    @formae.Flag { name = "subnet-cidr-1" }
    subnetCidr1: String = vars.subnetCidr1

    @formae.Flag { name = "subnet-cidr-2" }
    subnetCidr2: String = vars.subnetCidr2

    /// Availability zones for the two subnets. Default to <region>a / <region>b, but some
    /// regions don't offer contiguous letters (e.g. us-west-1 has a + c, not b) — set these then.
    @formae.Flag { name = "az-1" }
    az1: String = ""

    @formae.Flag { name = "az-2" }
    az2: String = ""
}

// Access mode, validated. Rejects flags that belong to the other mode so mistakes fail
// fast with a clear message rather than being silently ignored.
local access =
    let (a = properties.access)
        if (a != "alb" && a != "tailnet")
            throw("--access must be \"alb\" or \"tailnet\" (got \"\(a)\")")
        else if (a == "tailnet" && (properties.certArn != "" || properties.domain != "" || properties.allowCidr != ""))
            throw("--cert-arn, --domain and --allow-cidr apply only to --access alb")
        else if (a == "alb" && properties.tsAuthkey != "")
            throw("--ts-authkey applies only to --access tailnet")
        else a
local isAlb = access == "alb"
local isTailnet = access == "tailnet"
local isNew = properties.database == "new"

local n = properties.name

// Validate CIDR shape early (clearer than a slow AWS round-trip). AWS still enforces
// subnet-within-VPC containment, so an out-of-range subnet is caught at apply.
local cidrRegex = Regex(#"^\d{1,3}(\.\d{1,3}){3}/\d{1,2}$"#)
local function asCidr(value: String, flag: String): String =
    if (value.matches(cidrRegex)) value
    else throw("\(flag) must be a CIDR like 10.0.0.0/16, got: \(value)")
local vpcCidrVal = asCidr(properties.vpcCidr, "--vpc-cidr")
local subnetCidr1Val = asCidr(properties.subnetCidr1, "--subnet-cidr-1")
local subnetCidr2Val = asCidr(properties.subnetCidr2, "--subnet-cidr-2")
local natSubnetCidrVal = asCidr(vars.natSubnetCidr, "natSubnetCidr")

// Subnet AZs: explicit --az-1/--az-2 win, else derive <region>a / <region>b. Override for
// regions with non-contiguous zones (us-west-1 offers a + c, not b).
local az1 = if (properties.az1 != "") properties.az1 else "\(properties.region)a"
local az2 = if (properties.az2 != "") properties.az2 else "\(properties.region)b"

local taskSize = sizing.forSize(properties.size)

// Required inputs. certArnVal / tsAuthkeyVal are referenced only inside their own mode, so
// those throws fire only when that mode is selected; apiPasswordHashVal feeds the shared
// apiSecret (basic-auth is on in both modes), so it is required regardless of --access.
local certArnVal =
    if (properties.certArn == "") throw("--cert-arn is required for --access alb (an ACM certificate ARN for your domain)")
    else properties.certArn
local apiPasswordHashVal =
    if (properties.apiPasswordHash == "") throw("--api-password-hash is required (both modes). Generate it with aws/scripts/gen-api-credential.sh")
    else properties.apiPasswordHash
local tsAuthkeyVal =
    if (properties.tsAuthkey == "") throw("--ts-authkey is required for --access tailnet (a reusable Tailscale auth key)")
    else properties.tsAuthkey
local tsHostnameVal = if (properties.tsHostname == "") n else properties.tsHostname

// ALB ingress CIDR: an explicit --allow-cidr wins, else open to all.
local ingressCidr =
    if (properties.allowCidr != "") asCidr(properties.allowCidr, "--allow-cidr")
    else "0.0.0.0/0"

// New mode resolves the host from the provisioned DB at runtime via $FORMAE_DB_HOST;
// existing mode bakes the supplied host into the agent config at apply time.
local dbHostExpr =
    if (isNew) "$FORMAE_DB_HOST"
    else if (properties.dbHost == "") throw("--db-host is required when --database=existing")
    else properties.dbHost
local dbUserExpr =
    if (isNew) vars.dbUser
    else if (properties.dbUser == "") throw("--db-user is required when --database=existing")
    else properties.dbUser
local dbNameExpr =
    if (isNew) vars.dbName
    else if (properties.dbName == "") throw("--db-name is required when --database=existing")
    else properties.dbName

// Every bootstrap-tier resource carries Name + app=formae-agent; the latter lets the agent's
// own discovery filter (emitted into the config below) suppress this stack's substrate.
local function tagged(nm: String): Listing<aws.Tag> = new {
    new { key = "Name"; value = nm }
    new { key = "app"; value = "formae-agent" }
}

// The two subnets the agent + database live in, and the SG the agent task uses — both differ
// by mode (alb: public subnets + ALB-fronted SG; tailnet: private subnets + no-ingress SG).
local agentSubnet1 = if (isAlb) pubSubnet1 else privSubnet1
local agentSubnet2 = if (isAlb) pubSubnet2 else privSubnet2
local agentSg = if (isAlb) albTaskSg else tailnetAgentSg

// ── Agent config file ───────────────────────────────────────────────────────────
// Shared agent body: auth-basic (both modes) + server + datastore + background work +
// discovery filter. Each mode wraps it — alb uses it as-is; tailnet adds a top-level
// tailscale network block below.
// The heredoc that writes this is unquoted, so $FORMAE_* expand from the injected ECS
// secrets at write time; \(…) are Pkl interpolations resolved at apply.
local agentBody = """
  auth = new AuthBasic.AgentConfig {
    authorizedUsers {
      new AuthBasic.AuthorizedUser {
        username = "\(properties.apiUser)"
        password = "$FORMAE_API_PASSWORD_HASH"
      }
    }
  }
  server {
    port = \(vars.formaePort)
  }
  datastore {
    datastoreType = "postgres"
    postgres {
      host = "\(dbHostExpr)"
      port = \(properties.dbPort)
      user = "\(dbUserExpr)"
      password = "$FORMAE_DB_PASSWORD"
      database = "\(dbNameExpr)"
      connectionParams = "sslmode=require"
    }
  }
  synchronization {
    enabled = true
    interval = 300.s
  }
  discovery {
    enabled = true
    interval = 600.s
  }
  resourcePlugins {
    new Aws.PluginConfig {
      // Suppress this agent's own substrate (everything tagged app=formae-agent) from
      // discovery, so it isn't surfaced as unmanaged drift. Multiple MatchFilters are OR'd;
      // conditions within one are AND'd (a resource is excluded when any filter's conditions
      // all match). Most AWS types carry tags at $.Tags — but EFS is special: FileSystem and
      // AccessPoint expose tags under FileSystemTags / AccessPointTags, so a single $.Tags
      // filter silently misses them and they leak. They get their own filters below.
      // (EFS MountTargets are untaggable in AWS, so no tag filter can suppress them.)
      discoveryFilters = new Listing {
        new MatchFilter {
          resourceTypes = new Listing {
            "AWS::EC2::VPC"
            "AWS::EC2::Subnet"
            "AWS::EC2::InternetGateway"
            "AWS::EC2::RouteTable"
            "AWS::EC2::SecurityGroup"
            "AWS::EC2::NatGateway"
            "AWS::EC2::EIP"
            "AWS::RDS::DBInstance"
            "AWS::RDS::DBSubnetGroup"
            "AWS::SecretsManager::Secret"
            "AWS::ECS::Cluster"
            "AWS::ECS::Service"
            "AWS::ECS::TaskDefinition"
            "AWS::IAM::Role"
            "AWS::Logs::LogGroup"
            "AWS::ElasticLoadBalancingV2::LoadBalancer"
            "AWS::ElasticLoadBalancingV2::TargetGroup"
          }
          conditions = new Listing {
            new FilterCondition {
              propertyPath = "$.Tags[?(@.Key=='app')].Value"
              propertyValue = "formae-agent"
            }
          }
        }
        new MatchFilter {
          resourceTypes = new Listing { "AWS::EFS::FileSystem" }
          conditions = new Listing {
            new FilterCondition {
              propertyPath = "$.FileSystemTags[?(@.Key=='app')].Value"
              propertyValue = "formae-agent"
            }
          }
        }
        new MatchFilter {
          resourceTypes = new Listing { "AWS::EFS::AccessPoint" }
          conditions = new Listing {
            new FilterCondition {
              propertyPath = "$.AccessPointTags[?(@.Key=='app')].Value"
              propertyValue = "formae-agent"
            }
          }
        }
      }
    }
  }
"""

local albConfig = """
amends "formae:/Config.pkl"
import "plugins:/Aws.pkl" as Aws
import "plugins:/AuthBasic.pkl" as AuthBasic
agent {
\(agentBody)}
"""

local tailnetConfig = """
amends "formae:/Config.pkl"
import "plugins:/Aws.pkl" as Aws
import "plugins:/AuthBasic.pkl" as AuthBasic
agent {
\(agentBody)}
network = new NetworkConfig {
  type = "tailscale"
  tailscale = new TailscaleConfig {
    tls = true
    authKey = "$TAILSCALE_AUTHKEY"
    hostname = "\(tsHostnameVal)"
    advertiseTags { "tag:formae" }
  }
}
"""

local configScript = """
mkdir -p /home/pel/.config/formae &&
cat > /home/pel/.config/formae/formae.conf.pkl << PKLEOF
\(if (isAlb) albConfig else tailnetConfig)
PKLEOF
exec formae agent start
"""

// ── Manifest ──────────────────────────────────────────────────────────────────
// Everything this stack deploys, in dependency order; definitions follow below.
forma {
    vars.stack
    new formae.Target {
        label = "bootstrap-target"
        config = new aws.Config {
            region = properties.region
            profile = if (properties.profile == "") null else properties.profile
        }
    }

    // shared networking
    vpcRes
    igw
    igwAttach

    // networking — alb: public subnets + IGW route
    when (isAlb) {
        pubSubnet1
        pubSubnet2
        albRt
        albRoute
        albRtAssoc1
        albRtAssoc2
    }

    // networking — tailnet: private subnets + a public NAT subnet + NAT GW + dual route tables
    when (isTailnet) {
        privSubnet1
        privSubnet2
        natSubnet
        natEip
        natGw
        pubRt
        pubRoute
        pubRtAssoc
        privRt
        privRoute
        privRtAssoc1
        privRtAssoc2
    }

    // database (only when --database=new)
    when (isNew) {
        dbSg
        dbSgIngress
        dbSubnetGroup
        dbSecret
        db
    }

    // shared compute
    taskExecRole
    taskRole
    logGrp
    ecsCluster
    apiSecret

    // credential/identity — tailnet adds a TS authkey secret + EFS for tsnet identity
    when (isTailnet) {
        tsAuthSecret
        efsFs
        efsSg
        efsSgIngress
        efsMt1
        efsMt2
        efsAp
    }

    taskDef

    // ingress — alb: ALB + target group + HTTPS listener + SGs; tailnet: a no-ingress agent SG
    when (isAlb) {
        albSg
        albSgIngress
        albTaskSg
        albTaskSgIngress
        alb
        tg
        albListener
    }
    when (isTailnet) {
        tailnetAgentSg
    }

    ecsService
}

// ── Definitions ─────────────────────────────────────────────────────────────────

// shared networking
local vpcRes = new vpc.VPC {
    label = "\(n)-vpc"
    cidrBlock = vpcCidrVal
    enableDnsHostnames = true
    enableDnsSupport = true
    tags = tagged("\(n)-vpc")
}

local igw = new internetgateway.InternetGateway {
    label = "\(n)-igw"
    tags = tagged("\(n)-igw")
}

local igwAttach = new vpcgatewayattachment.VPCGatewayAttachment {
    label = "\(n)-igw-attach"
    vpcId = vpcRes.res.id
    internetGatewayId = igw.res.id
}

// ── Mode A (alb): public subnets, IGW route, no NAT ───────────────────────────────
local pubSubnet1 = new subnet.Subnet {
    label = "\(n)-subnet-1"
    vpcId = vpcRes.res.id
    cidrBlock = subnetCidr1Val
    availabilityZone = az1
    mapPublicIpOnLaunch = true
    tags = tagged("\(n)-subnet-1")
}

local pubSubnet2 = new subnet.Subnet {
    label = "\(n)-subnet-2"
    vpcId = vpcRes.res.id
    cidrBlock = subnetCidr2Val
    availabilityZone = az2
    mapPublicIpOnLaunch = true
    tags = tagged("\(n)-subnet-2")
}

local albRt = new routetable.RouteTable {
    label = "\(n)-rt"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-rt")
}

local albRoute = new route.Route {
    label = "\(n)-route"
    routeTableId = albRt.res.id
    destinationCidrBlock = "0.0.0.0/0"
    gatewayId = igw.res.id
}

local albRtAssoc1 = new subnetroutetableassociation.SubnetRouteTableAssociation {
    label = "\(n)-rt-assoc-1"
    subnetId = pubSubnet1.res.id
    routeTableId = albRt.res.id
}

local albRtAssoc2 = new subnetroutetableassociation.SubnetRouteTableAssociation {
    label = "\(n)-rt-assoc-2"
    subnetId = pubSubnet2.res.id
    routeTableId = albRt.res.id
}

// ── Mode B (tailnet): private subnets, public NAT subnet, NAT GW, dual route tables ──
local privSubnet1 = new subnet.Subnet {
    label = "\(n)-private-1"
    vpcId = vpcRes.res.id
    cidrBlock = subnetCidr1Val
    availabilityZone = az1
    tags = tagged("\(n)-private-1")
}

local privSubnet2 = new subnet.Subnet {
    label = "\(n)-private-2"
    vpcId = vpcRes.res.id
    cidrBlock = subnetCidr2Val
    availabilityZone = az2
    tags = tagged("\(n)-private-2")
}

local natSubnet = new subnet.Subnet {
    label = "\(n)-nat-public"
    vpcId = vpcRes.res.id
    cidrBlock = natSubnetCidrVal
    availabilityZone = az1
    mapPublicIpOnLaunch = true
    tags = tagged("\(n)-nat-public")
}

local natEip = new eip.EIP {
    label = "\(n)-nat-eip"
    domain = "vpc"
    tags = tagged("\(n)-nat-eip")
}

local natGw = new natgateway.NatGateway {
    label = "\(n)-nat"
    subnetId = natSubnet.res.subnetId
    allocationId = natEip.res.allocationId
    tags = tagged("\(n)-nat")
}

local pubRt = new routetable.RouteTable {
    label = "\(n)-rt-public"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-rt-public")
}

local pubRoute = new route.Route {
    label = "\(n)-route-public"
    routeTableId = pubRt.res.id
    destinationCidrBlock = "0.0.0.0/0"
    gatewayId = igw.res.id
}

local pubRtAssoc = new subnetroutetableassociation.SubnetRouteTableAssociation {
    label = "\(n)-rt-assoc-public"
    subnetId = natSubnet.res.id
    routeTableId = pubRt.res.id
}

local privRt = new routetable.RouteTable {
    label = "\(n)-rt-private"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-rt-private")
}

local privRoute = new route.Route {
    label = "\(n)-route-private"
    routeTableId = privRt.res.id
    destinationCidrBlock = "0.0.0.0/0"
    natGatewayId = natGw.res.natGatewayId
}

local privRtAssoc1 = new subnetroutetableassociation.SubnetRouteTableAssociation {
    label = "\(n)-rt-assoc-private-1"
    subnetId = privSubnet1.res.id
    routeTableId = privRt.res.id
}

local privRtAssoc2 = new subnetroutetableassociation.SubnetRouteTableAssociation {
    label = "\(n)-rt-assoc-private-2"
    subnetId = privSubnet2.res.id
    routeTableId = privRt.res.id
}

// ── Database (only emitted when --database=new) ───────────────────────────────────
local dbSg = new securitygroup.SecurityGroup {
    label = "\(n)-db-sg"
    groupDescription = "Allow PostgreSQL from within the VPC (the ECS task)"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-db-sg")
}

local dbSgIngress = new securitygroupingress.SecurityGroupIngress {
    label = "\(n)-db-sg-ingress"
    ipProtocol = "tcp"
    fromPort = 5432
    toPort = 5432
    cidrIp = vpcCidrVal
    groupId = dbSg.res.groupId
}

local dbSubnetGroup = new dbsubnetgroup.DBSubnetGroup {
    label = "\(n)-db-subnet-group"
    dbSubnetGroupDescription = "Subnet group for the formae database"
    subnetIds { agentSubnet1.res.subnetId; agentSubnet2.res.subnetId }
    tags = tagged("\(n)-db-subnet-group")
}

local dbSecret = new secret.Secret {
    label = "\(n)-db-secret"
    name = "\(n)-db-password"
    description = "formae database master password (generated)"
    secretString = formae.value(random.password(24, false)).opaque.setOnce
    tags = tagged("\(n)-db-secret")
}

local db = new dbinstance.DBInstance {
    label = "\(n)-db"
    dbInstanceIdentifier = "\(n)-db"
    engine = "postgres"
    engineVersion = vars.dbEngineVersion
    dbInstanceClass = vars.dbInstanceClass
    // Storage as a typed DataSize; .toUnit("gib") normalizes to the GiB the schema expects,
    // so the literal's unit can change safely.
    allocatedStorage = 20.gib.toUnit("gib").value.toInt().toString()
    // Storage autoscaling ceiling. Multi-AZ is off for a lean default; enable multiAZ +
    // raise this for production (see README).
    maxAllocatedStorage = 100.gib.toUnit("gib").value.toInt()
    dbName = dbNameExpr
    masterUsername = dbUserExpr
    masterUserPassword = dbSecret.res.secretString
    dbSubnetGroupName = dbSubnetGroup.res.dbSubnetGroupName
    vpcSecurityGroups { dbSg.res.groupId }
    storageEncrypted = true
    publiclyAccessible = false
    multiAZ = false
    tags = tagged("\(n)-db")
}

// ── Shared compute (IAM, logs, cluster) ───────────────────────────────────────────
local ecsAssumeRole = new Dynamic {
    ["Version"] = "2012-10-17"
    ["Statement"] = new Listing {
        new Dynamic {
            ["Effect"] = "Allow"
            ["Principal"] = new Dynamic { ["Service"] = "ecs-tasks.amazonaws.com" }
            ["Action"] = "sts:AssumeRole"
        }
    }
}

local taskExecRole = new role.Role {
    label = "\(n)-exec-role"
    roleName = "\(n)-exec-role"
    assumeRolePolicyDocument = ecsAssumeRole
    managedPolicyArns {
        "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
    }
    policies {
        new role.RolePolicy {
            policyName = "\(n)-secrets-access"
            policyDocument {
                ["Version"] = "2012-10-17"
                ["Statement"] = new Listing {
                    new Dynamic {
                        ["Effect"] = "Allow"
                        ["Action"] = "secretsmanager:GetSecretValue"
                        ["Resource"] = "*"
                    }
                }
            }
        }
    }
    tags = tagged("\(n)-exec-role")
}

// The agent's operating identity. PowerUserAccess excludes IAM, so the inline policy adds
// IAM management + iam:List*/Get* (without the reads, discovery 403-spams every cycle).
// The ssmmessages perms back `aws ecs execute-command` (shell into the running agent).
local taskRole = new role.Role {
    label = "\(n)-task-role"
    roleName = "\(n)-task-role"
    assumeRolePolicyDocument = ecsAssumeRole
    managedPolicyArns {
        "arn:aws:iam::aws:policy/PowerUserAccess"
    }
    policies {
        new role.RolePolicy {
            policyName = "\(n)-iam"
            policyDocument {
                ["Version"] = "2012-10-17"
                ["Statement"] = new Listing {
                    new Dynamic {
                        ["Effect"] = "Allow"
                        ["Action"] = new Listing {
                            "iam:CreateRole"
                            "iam:DeleteRole"
                            "iam:GetRole"
                            "iam:ListRoles"
                            "iam:UpdateRole"
                            "iam:UpdateAssumeRolePolicy"
                            "iam:TagRole"
                            "iam:UntagRole"
                            "iam:PutRolePolicy"
                            "iam:DeleteRolePolicy"
                            "iam:GetRolePolicy"
                            "iam:ListRolePolicies"
                            "iam:AttachRolePolicy"
                            "iam:DetachRolePolicy"
                            "iam:ListAttachedRolePolicies"
                            "iam:CreatePolicy"
                            "iam:DeletePolicy"
                            "iam:GetPolicy"
                            "iam:ListPolicies"
                            "iam:CreatePolicyVersion"
                            "iam:DeletePolicyVersion"
                            "iam:GetPolicyVersion"
                            "iam:ListPolicyVersions"
                            "iam:SetDefaultPolicyVersion"
                            "iam:CreateInstanceProfile"
                            "iam:DeleteInstanceProfile"
                            "iam:GetInstanceProfile"
                            "iam:AddRoleToInstanceProfile"
                            "iam:RemoveRoleFromInstanceProfile"
                            "iam:CreateUser"
                            "iam:DeleteUser"
                            "iam:GetUser"
                            "iam:TagUser"
                            "iam:UntagUser"
                            "iam:CreateGroup"
                            "iam:DeleteGroup"
                            "iam:GetGroup"
                            "iam:PassRole"
                        }
                        ["Resource"] = "*"
                    }
                    new Dynamic {
                        ["Effect"] = "Allow"
                        ["Action"] = new Listing {
                            "iam:Get*"
                            "iam:List*"
                        }
                        ["Resource"] = "*"
                    }
                }
            }
        }
        new role.RolePolicy {
            policyName = "\(n)-ecs-exec"
            policyDocument {
                ["Version"] = "2012-10-17"
                ["Statement"] = new Listing {
                    new Dynamic {
                        ["Effect"] = "Allow"
                        ["Action"] = new Listing {
                            "ssmmessages:CreateControlChannel"
                            "ssmmessages:CreateDataChannel"
                            "ssmmessages:OpenControlChannel"
                            "ssmmessages:OpenDataChannel"
                        }
                        ["Resource"] = "*"
                    }
                }
            }
        }
    }
    tags = tagged("\(n)-task-role")
}

local logGrp = new loggroup.LogGroup {
    label = "\(n)-logs"
    logGroupName = "/ecs/\(n)"
    retentionInDays = 14
    tags = tagged("\(n)-logs")
}

local ecsCluster = new ecscluster.Cluster {
    label = "\(n)-ecs-cluster"
    clusterName = "\(n)-cluster"
    tags = tagged("\(n)-cluster")
}

// ── Mode A (alb): in-stack basic-auth credential secret ───────────────────────────
// Holds the operator-supplied bcrypt hash; injected as $FORMAE_API_PASSWORD_HASH at task
// start, never written into the task definition. Lifecycle tied to this stack.
local apiSecret = new secret.Secret {
    label = "\(n)-api-secret"
    name = "\(n)-api-credential"
    description = "formae agent API basic-auth bcrypt hash"
    secretString = apiPasswordHashVal
    tags = tagged("\(n)-api-secret")
}

// ── Mode B (tailnet): Tailscale auth key secret + EFS for tsnet identity ──────────
local tsAuthSecret = new secret.Secret {
    label = "\(n)-ts-secret"
    name = "\(n)-ts-authkey"
    description = "Tailscale auth key for the formae agent"
    secretString = tsAuthkeyVal
    tags = tagged("\(n)-ts-secret")
}

// EFS persists the agent's tsnet machine identity across task replacements (otherwise the
// agent re-registers under a new tailnet hostname on every restart).
local efsFs = new filesystem.FileSystem {
    label = "\(n)-tsnet-efs"
    encrypted = true
    performanceMode = "generalPurpose"
    throughputMode = "bursting"
    fileSystemTags = tagged("\(n)-tsnet-efs")
}

local efsSg = new securitygroup.SecurityGroup {
    label = "\(n)-efs-sg"
    groupDescription = "Allow NFS from the formae agent task to the tsnet EFS"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-efs-sg")
}

local efsSgIngress = new securitygroupingress.SecurityGroupIngress {
    label = "\(n)-efs-sg-ingress"
    ipProtocol = "tcp"
    fromPort = 2049
    toPort = 2049
    sourceSecurityGroupId = tailnetAgentSg.res.groupId
    groupId = efsSg.res.groupId
}

local efsMt1 = new mounttarget.MountTarget {
    label = "\(n)-efs-mt-1"
    fileSystemId = efsFs.res.fileSystemId
    subnetId = privSubnet1.res.subnetId
    securityGroups { efsSg.res.groupId }
}

local efsMt2 = new mounttarget.MountTarget {
    label = "\(n)-efs-mt-2"
    fileSystemId = efsFs.res.fileSystemId
    subnetId = privSubnet2.res.subnetId
    securityGroups { efsSg.res.groupId }
}

// Access point pins the POSIX identity to pel (uid/gid 1001 in the published image) and
// chroots into /tsnet, so the non-root container can own its identity directory.
local efsAp = new accesspoint.AccessPoint {
    label = "\(n)-efs-ap"
    fileSystemId = efsFs.res.fileSystemId
    posixUser = new {
        uid = "1001"
        gid = "1001"
    }
    rootDirectory = new {
        path = "/tsnet"
        creationInfo = new {
            ownerUid = "1001"
            ownerGid = "1001"
            permissions = "0700"
        }
    }
    accessPointTags = tagged("\(n)-efs-ap")
}

// ── Agent task + service ──────────────────────────────────────────────────────────
local taskDef = new taskdefinition.TaskDefinition {
    label = "\(n)-task-def"
    family = "\(n)-task"
    requiresCompatibilities { "FARGATE" }
    networkMode = "awsvpc"
    cpu = taskSize.cpu
    memory = taskSize.memoryMib
    executionRoleArn = taskExecRole.res.arn
    taskRoleArn = taskRole.res.arn
    containerDefinitions {
        new taskdefinition.ContainerDefinition {
            name = "formae-agent"
            image = properties.formaeImage
            essential = true
            entryPoint { "sh"; "-c" }
            command { configScript }
            portMappings {
                new taskdefinition.PortMapping {
                    containerPort = vars.formaePort
                    protocol = "tcp"
                }
            }
            // New mode injects the provisioned DB host as an env var; existing mode bakes
            // the supplied host into the config script, so no host env var.
            environment {
                when (isNew) {
                    new taskdefinition.KeyValuePair {
                        name = "FORMAE_DB_HOST"
                        value = db.res.endpointAddress
                    }
                }
            }
            // Secrets injected at runtime from Secrets Manager (never in the task def): the
            // DB password (both modes), plus the mode's credential.
            secrets {
                new taskdefinition.Secret {
                    name = "FORMAE_DB_PASSWORD"
                    valueFrom =
                        if (isNew) dbSecret.res.arn
                        else if (properties.dbPasswordSecretArn == "") throw("--db-password-secret-arn is required when --database=existing")
                        else properties.dbPasswordSecretArn
                }
                new taskdefinition.Secret {
                    name = "FORMAE_API_PASSWORD_HASH"
                    valueFrom = apiSecret.res.arn
                }
                when (isTailnet) {
                    new taskdefinition.Secret {
                        name = "TAILSCALE_AUTHKEY"
                        valueFrom = tsAuthSecret.res.arn
                    }
                }
            }
            // tailnet mode: mount the EFS access point at the tsnet identity directory.
            mountPoints {
                when (isTailnet) {
                    new taskdefinition.MountPoint {
                        sourceVolume = "tsnet"
                        containerPath = "/home/pel/.config/tsnet-formae"
                    }
                }
            }
            logConfiguration = new taskdefinition.LogConfiguration {
                logDriver = "awslogs"
                options {
                    ["awslogs-group"] = "/ecs/\(n)"
                    ["awslogs-region"] = properties.region
                    ["awslogs-stream-prefix"] = "formae"
                }
            }
        }
    }
    volumes {
        when (isTailnet) {
            new taskdefinition.Volume {
                name = "tsnet"
                eFSVolumeConfiguration = new {
                    filesystemId = efsFs.res.fileSystemId
                    transitEncryption = "ENABLED"
                    authorizationConfig = new {
                        accessPointId = efsAp.res.accessPointId
                        iAM = "ENABLED"
                    }
                }
            }
        }
    }
    tags = tagged("\(n)-task-def")
}

// ── Mode A (alb): ALB + target group + HTTPS listener + security groups ───────────
local albSg = new securitygroup.SecurityGroup {
    label = "\(n)-alb-sg"
    groupDescription = "Allow HTTPS to the formae API"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-alb-sg")
}

local albSgIngress = new securitygroupingress.SecurityGroupIngress {
    label = "\(n)-alb-sg-ingress"
    ipProtocol = "tcp"
    fromPort = 443
    toPort = 443
    cidrIp = ingressCidr
    groupId = albSg.res.groupId
}

local albTaskSg = new securitygroup.SecurityGroup {
    label = "\(n)-task-sg"
    groupDescription = "Allow traffic from the ALB to the formae task"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-task-sg")
}

local albTaskSgIngress = new securitygroupingress.SecurityGroupIngress {
    label = "\(n)-task-sg-ingress"
    ipProtocol = "tcp"
    fromPort = vars.formaePort
    toPort = vars.formaePort
    sourceSecurityGroupId = albSg.res.groupId
    groupId = albTaskSg.res.groupId
}

local alb = new loadbalancer.LoadBalancer {
    label = "\(n)-alb"
    name = "\(n)-alb"
    subnets { pubSubnet1.res.subnetId; pubSubnet2.res.subnetId }
    securityGroups { albSg.res.groupId }
    scheme = "internet-facing"
    type = "application"
    tags = tagged("\(n)-alb")
}

local tg = new targetgroup.TargetGroup {
    label = "\(n)-tg"
    name = "\(n)-tg"
    vpcId = vpcRes.res.id
    port = vars.formaePort
    protocol = "HTTP"
    targetType = "ip"
    healthCheckEnabled = true
    healthCheckPath = "/api/v1/health"
    healthCheckProtocol = "HTTP"
    healthCheckPort = "\(vars.formaePort)"
    matcher = new targetgroup.Matcher { httpCode = "200" }
    healthCheckIntervalSeconds = 30
    tags = tagged("\(n)-tg")
}

// HTTPS listener terminating TLS with the operator's ACM cert. The agent speaks HTTP behind
// it; the ALB health check hits /api/v1/health, which auth-basic exempts, so targets stay
// healthy. Connect via https://<your-domain> (the cert must match that hostname).
local albListener = new listener.Listener {
    label = "\(n)-listener"
    loadBalancerArn = alb.res.loadBalancerArn
    port = 443
    protocol = "HTTPS"
    sslPolicy = "ELBSecurityPolicy-TLS13-1-2-2021-06"
    certificates {
        new listener.Certificate { certificateArn = certArnVal }
    }
    defaultActions {
        new listener.Action {
            type = "forward"
            targetGroupArn = tg.res.targetGroupArn
        }
    }
}

// ── Mode B (tailnet): the agent task SG (no ingress — reached over the tailnet) ───
local tailnetAgentSg = new securitygroup.SecurityGroup {
    label = "\(n)-agent-sg"
    groupDescription = "formae agent task - no ingress, default egress, reached via Tailscale"
    vpcId = vpcRes.res.id
    tags = tagged("\(n)-agent-sg")
}

// ── Service (shared; networking + load balancer wiring differ by mode) ────────────
local ecsService = new service.Service {
    label = "\(n)-ecs-service"
    serviceName = "\(n)-service"
    cluster = ecsCluster.res.arn
    taskDefinition = new taskdefinition.TaskDefinitionResolvable {
        label = taskDef.label
        stack = vars.stack.label
    }.taskDefinitionArn
    desiredCount = 1
    launchType = "FARGATE"
    enableExecuteCommand = true
    // Fail a bad rollout fast (and roll back to the last good task def) instead of retrying
    // a broken task forever and hanging the apply.
    deploymentConfiguration = new service.DeploymentConfiguration {
        maximumPercent = 200
        minimumHealthyPercent = 100
        deploymentCircuitBreaker = new service.DeploymentCircuitBreaker {
            enable = true
            rollback = true
        }
    }
    networkConfiguration = new service.NetworkConfiguration {
        awsvpcConfiguration = new service.AwsVpcConfiguration {
            // alb: public subnets + public IP for egress; tailnet: private subnets, no public IP.
            assignPublicIp = if (isAlb) "ENABLED" else "DISABLED"
            subnets { agentSubnet1.res.subnetId; agentSubnet2.res.subnetId }
            securityGroups { agentSg.res.groupId }
        }
    }
    // alb mode registers with the target group; tailnet mode has no load balancer.
    loadBalancers {
        when (isAlb) {
            new service.LoadBalancer {
                targetGroupArn = tg.res.targetGroupArn
                containerName = "formae-agent"
                containerPort = vars.formaePort
            }
        }
    }
    tags = tagged("\(n)-service")
}
