// Deregisters the bootstrap-target (the inverse of the target registered by bootstrap.pkl).
// Identified by label; config just needs to match the registered target.
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@aws/aws.pkl"

forma {
    new formae.Target {
        label = "bootstrap-target"
        config = new aws.Config {
            region = "us-west-1"
        }
    }
}
